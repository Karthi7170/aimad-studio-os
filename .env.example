# Server-only Neon Postgres connection from Neon Console > Connect.
DATABASE_URL=postgresql://STUDIO_OS_USER:PASSWORD@HOST/studio_os?sslmode=require
# Neon Managed Better Auth URL from Neon Console > Auth > Configuration.
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_URL/studio_os/auth
# Generate a fresh random secret, at least 32 characters. Never commit the real value.
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
# Restrict the workspace to this verified Google/Neon Auth identity.
STUDIO_OWNER_EMAIL=OWNER_EMAIL@example.com
